NODE_ENV=development
PORT=3001
DATABASE_URL="mysql://user:password@localhost:3306/ai_shortvideo"
DEPLOYMENT_ACTOR_TENANT_ID="replace-with-local-tenant-id"
DEPLOYMENT_ACTOR_USER_ID="replace-with-local-user-id"
# Only for an isolated development session with AI_PROVIDER_MODE=mock and no DATABASE_URL.
NOVEL_ASYNC_DISPATCH_DEV_ENABLED=false
# E1-only persistent dispatch: development + mock + dedicated loopback MySQL URL.
# DATABASE_URL must exactly match E1_MYSQL_SMOKE_URL; never use the normal project database.
NOVEL_ASYNC_DISPATCH_E1_MYSQL_ENABLED=false
E1_MYSQL_SMOKE_URL=""
# Set a dedicated random secret of at least 32 bytes when enabling the development transport.
NOVEL_ASYNC_SCOPE_SECRET=""
NOVEL_ASYNC_API_AUDIENCE=""
